# ============================================
# Nova Storefront — Environment Variables
# ============================================
# Copy this file to .env for local development.
# On Vercel, set these in Settings → Environment Variables.

# ---- DATABASE ----
# LOCAL (sandbox): local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# VERCEL: After creating Vercel Postgres (Neon), it auto-injects these:
# POSTGRES_URL=postgres://...     (set automatically by Vercel)
# No need to set manually — the app detects it.

# ---- ADMIN ----
ADMIN_USERNAME=Sasika
ADMIN_PASSWORD=2007@26437

# ---- SECRETS ----
# Used for JWT session signing (admin + user auth).
# Use a long random string in production.
JWT_SECRET=your-long-random-secret-here
