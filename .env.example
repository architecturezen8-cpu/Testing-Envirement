# ============================================
# St. Thomas' College Matale — Environment Variables
# ============================================
# Copy this file to .env for local development. .env is git-ignored
# and must NEVER be committed. On Vercel, set these in Settings →
# Environment Variables.

# ---- DATABASE ----
# LOCAL (sandbox): local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# VERCEL: After creating Vercel Postgres (Neon), it auto-injects these:
# POSTGRES_URL=postgres://...     (set automatically by Vercel)

# ---- ADMIN ----
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-long-random-password

# ---- SECRETS ----
# Used for JWT session signing (admin + user auth).
# Use a long random string in production.
JWT_SECRET=change-me-long-random-secret
