# Copy to .env and fill in real values — .env is git-ignored and must NEVER be committed.

# Port the admin backend listens on
PORT=3001

# PostgreSQL connection string for the store database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Admin login — must match the store's ADMIN_USERNAME / ADMIN_PASSWORD
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me-long-random-password

# JWT signing secret — use a long random string in production
JWT_SECRET=change-me-long-random-secret

# Session lifetime in seconds (default: 28800 = 8h)
TOKEN_TTL_SECONDS=28800
